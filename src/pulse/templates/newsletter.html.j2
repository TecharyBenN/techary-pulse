<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body style="margin:0;padding:0;background:#ebebeb;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ebebeb;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:100%;background:#ffffff;font-family:'DM Sans',Arial,sans-serif;color:#333333;font-size:16px;line-height:1.5;">
<tr><td style="padding:24px 32px;border-top:6px solid #47d7ac;">
<p style="margin:0 0 4px;font-size:13px;font-weight:bold;color:#14bea0;">{{ headline_title }}</p>
<h1 style="margin:0 0 16px;font-size:24px;line-height:1.3;color:#000000;">{{ headline }}</h1>
<p style="margin:0;">{{ intro }}</p>
</td></tr>
{% for section, entries in sections %}
<tr><td style="padding:8px 32px 16px;">
<h2 style="margin:0 0 8px;padding-bottom:4px;font-size:18px;color:#000000;border-bottom:2px solid #47d7ac;">{{ section.title }}</h2>
{% for entry in entries %}
<p style="margin:0 0 12px;">{{ entry.text }}</p>
{% endfor %}
</td></tr>
{% endfor %}
<tr><td style="padding:24px 32px;background:#ebebeb;font-size:14px;">
<h2 style="margin:0 0 12px;font-size:16px;color:#000000;">Review</h2>
{% if review.check_failures %}
<h3 style="margin:12px 0 4px;font-size:14px;">Check failures</h3>
<ul style="margin:0;padding-left:20px;">{% for failure in review.check_failures %}<li>{{ failure }}</li>{% endfor %}</ul>
{% endif %}
{% if review.sensitivity_exclusions %}
<h3 style="margin:12px 0 4px;font-size:14px;">Excluded for sensitivity</h3>
<ul style="margin:0;padding-left:20px;">{% for source, type, evidence in review.sensitivity_exclusions %}<li>{{ source.sender }}, "{{ source.subject }}": {{ type }} ({{ evidence }})</li>{% endfor %}</ul>
{% endif %}
{% if review.other_exclusions %}
<h3 style="margin:12px 0 4px;font-size:14px;">Other exclusions</h3>
<ul style="margin:0;padding-left:20px;">{% for source, reason in review.other_exclusions %}<li>{{ source.sender }}, "{{ source.subject }}": {{ reason }}</li>{% endfor %}</ul>
{% endif %}
{% if review.rejected_subjects %}
<h3 style="margin:12px 0 4px;font-size:14px;">Rejected</h3>
<ul style="margin:0;padding-left:20px;">{% for subject in review.rejected_subjects %}<li>{{ subject }}</li>{% endfor %}</ul>
{% endif %}
{% if review.with_attachments %}
<h3 style="margin:12px 0 4px;font-size:14px;">Attachments not included</h3>
<ul style="margin:0;padding-left:20px;">{% for source in review.with_attachments %}<li>{{ source.sender }}, "{{ source.subject }}"</li>{% endfor %}</ul>
{% endif %}
{% if review.source_map %}
<h3 style="margin:12px 0 4px;font-size:14px;">Sources</h3>
<ul style="margin:0;padding-left:20px;">{% for entry_text, sources in review.source_map %}<li>{{ entry_text }}<br>{% for source in sources %}{{ source.sender }}, "{{ source.subject }}"{% if not loop.last %}; {% endif %}{% endfor %}</li>{% endfor %}</ul>
{% endif %}
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
